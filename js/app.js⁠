function toggleAccordion(id) {
    const el = document.getElementById(id);
    const arrow = document.getElementById(id + 'Arrow');
    if (el.style.display === 'block') {
        el.style.display = 'none';
        arrow.textContent = '▼';
    } else {
        el.style.display = 'block';
        arrow.textContent = '▲';
    }
}

