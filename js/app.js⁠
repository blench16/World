(() => {
    let zipInstance = null, targetLevelDatPath = null, rawLevelDat = null, selectedFile = null;
    let parsedNBT = {}, originalBackup = null, isSingleDat = false;
    const targetKeys = ['hasBeenLoadedInCreative', 'cheatsEnabled', 'commandsEnabled'];

    const TAG_END = 0, TAG_BYTE = 1, TAG_SHORT = 2, TAG_INT = 3, TAG_LONG = 4;
    const TAG_FLOAT = 5, TAG_DOUBLE = 6, TAG_BYTE_ARRAY = 7, TAG_STRING = 8;
    const TAG_LIST = 9, TAG_COMPOUND = 10, TAG_INT_ARRAY = 11, TAG_LONG_ARRAY = 12;

    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');

    dropzone.addEventListener('click', () => fileInput.click());
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
        dropzone.addEventListener(ev, e => {
            e.preventDefault(); e.stopPropagation();
            if (ev === 'dragenter' || ev === 'dragover') dropzone.classList.add('dragover');
            else dropzone.classList.remove('dragover');
            if (ev === 'drop' && e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                fileInput.dispatchEvent(new Event('change'));
            }
        });
    });

    function log(msg) {
        const logDiv = document.getElementById('log');
        logDiv.style.display = 'block';
        logDiv.textContent += msg + '\n';
        logDiv.scrollTop = logDiv.scrollHeight;
    }

    fileInput.addEventListener('change', async e => {
        selectedFile = e.target.files[0];
        if (!selectedFile) return;
        window.isDemoMode = false;
        
        document.getElementById('introGuides').style.display = 'none';
        document.getElementById('loadDemoBtn').style.display = 'none';

        document.getElementById('fileTitle').textContent = selectedFile.name;
        document.getElementById('fileSub').textContent = (selectedFile.size / 1024 / 1024).toFixed(2) + ' MB';
        log('>> 开始解析文件...');

        try {
            if (selectedFile.name.toLowerCase().endsWith('.dat')) {
                isSingleDat = true;
                zipInstance = null;
                targetLevelDatPath = selectedFile.name;
                const arrayBuffer = await selectedFile.arrayBuffer();
                rawLevelDat = new Uint8Array(arrayBuffer);
                originalBackup = new Uint8Array(rawLevelDat);
                document.getElementById('backupNoteText').textContent = '💾 修复时自动备份原始 level.dat 为 level.dat.bak';
                parseNBT(rawLevelDat);
            } else {
                isSingleDat = false;
                if (typeof JSZip === 'undefined') return alert('JSZip 库未加载，请刷新页面后重试');
                zipInstance = new JSZip();
                const zipContent = await zipInstance.loadAsync(selectedFile);
                targetLevelDatPath = null;
                zipContent.forEach(path => path.toLowerCase().endsWith('level.dat') && (targetLevelDatPath = path));
                if (!targetLevelDatPath) return alert('未找到 level.dat！请选择完整存档包（.mcworld / .zip）或单独的 level.dat');
                
                rawLevelDat = await zipContent.file(targetLevelDatPath).async('uint8array');
                originalBackup = new Uint8Array(rawLevelDat);
                document.getElementById('backupNoteText').textContent = '💾 修复时自动备份原 level.dat 到压缩包内 level.dat.bak';
                parseNBT(rawLevelDat);
            }
        } catch (err) { 
            alert('读取失败：' + err.message); 
            log('[ERROR] ' + err.message);
            document.getElementById('info_nbt_status').textContent = '解析异常';
            document.getElementById('info_nbt_status').className = 'badge badge-bad';
        }
    });

    function parseNBT(buf) {
        parsedNBT = {};
        const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
        
        let offset = 0;
        if (buf.length > 8 && view.getUint8(8) === TAG_COMPOUND) {
            offset = 8;
        }

        if (view.getUint8(offset) !== TAG_COMPOUND) {
            throw new Error('无效 level.dat：根节点非 TAG_Compound');
        }
        offset++;

        const rootNameLen = view.getUint16(offset, true); 
        offset += 2 + rootNameLen;

        while (offset < buf.length) {
            const tagType = view.getUint8(offset++);
            if (tagType === TAG_END) break;
            
            const nameLen = view.getUint16(offset, true); 
            offset += 2;
            const name = new TextDecoder().decode(buf.subarray(offset, offset + nameLen));
            offset += nameLen;

            if (tagType === TAG_BYTE) {
                parsedNBT[name] = view.getInt8(offset++);
                if (targetKeys.includes(name)) log(`   找到 ${name} = ${parsedNBT[name]}`);
            } else if (tagType === TAG_STRING && name === 'LevelName') {
                const sLen = view.getUint16(offset, true);
                parsedNBT[name] = new TextDecoder().decode(buf.subarray(offset + 2, offset + 2 + sLen));
                offset += 2 + sLen;
            } else if (tagType === TAG_INT && name === 'GameType') {
                parsedNBT[name] = view.getInt32(offset, true); offset += 4;
            } else if (tagType === TAG_INT && name === 'Difficulty') {
                parsedNBT[name] = view.getInt32(offset, true); offset += 4;
            } else if (tagType === TAG_LONG && name === 'RandomSeed') {
                parsedNBT[name] = view.getBigInt64(offset, true).toString(); offset += 8;
            } else if (tagType === TAG_LONG && name === 'Time') {
                parsedNBT[name] = view.getBigInt64(offset, true); offset += 8;
            } else {
                offset += skipTag(tagType, view, offset);
            }
        }
        analyzeAndRender();
    }

    function skipTag(type, view, offset) {
        if (offset >= view.byteLength) return 0;
        switch (type) {
            case TAG_BYTE: return 1;
            case TAG_SHORT: return 2;
            case TAG_INT: return 4;
            case TAG_LONG: return 8;
            case TAG_FLOAT: return 4;
            case TAG_DOUBLE: return 8;
            case TAG_BYTE_ARRAY: return 4 + view.getInt32(offset, true);
            case TAG_STRING: return 2 + view.getUint16(offset, true);
            case TAG_INT_ARRAY: return 4 + view.getInt32(offset, true) * 4;
            case TAG_LONG_ARRAY: return 4 + view.getInt32(offset, true) * 8;
            case TAG_LIST: {
                const subType = view.getUint8(offset);
                const listLen = view.getInt32(offset + 1, true);
                let skipped = 5;
                for (let i = 0; i < listLen; i++) {
                    skipped += skipTag(subType, view, offset + skipped);
                }
                return skipped;
            }
            case TAG_COMPOUND: {
                let skipped = 0;
                while (offset + skipped < view.byteLength) {
                    const subType = view.getUint8(offset + skipped++);
                    if (subType === TAG_END) break;
                    const nameLen = view.getUint16(offset + skipped, true);
                    skipped += 2 + nameLen;
                    skipped += skipTag(subType, view, offset + skipped);
                }
                return skipped;
            }
            default: return 0;
        }
    }

    function analyzeAndRender() {
        document.getElementById('infoCard').style.display = 'block';
        document.getElementById('info_name').textContent = parsedNBT.LevelName || '未知世界';
        
        // 1. 游戏模式
        const gameModes = { 0: '生存 (Survival)', 1: '创造 (Creative)', 2: '冒险 (Adventure)', 3: '旁观 (Spectator)' };
        document.getElementById('info_mode').textContent = gameModes[parsedNBT.GameType] ?? `模式 (${parsedNBT.GameType})`;
        
        // 2. 难度
        const difficulties = { 0: '和平 (Peaceful)', 1: '简单 (Easy)', 2: '普通 (Normal)', 3: '困难 (Hard)' };
        document.getElementById('info_difficulty').textContent = difficulties[parsedNBT.Difficulty] ?? `未知 (${parsedNBT.Difficulty ?? '-'})`;

        // 3. 种子
        document.getElementById('info_seed').textContent = parsedNBT.RandomSeed || '未知';

        // 4. 游戏时间/天数
        if (parsedNBT.Time !== undefined) {
            const ticks = Number(parsedNBT.Time);
            const minutes = (ticks / 20 / 60).toFixed(1);
            const days = Math.floor(ticks / 24000);
            document.getElementById('info_time').textContent = `${minutes} 分钟 (第 ${days} 天)`;
        } else {
            document.getElementById('info_time').textContent = '未知';
        }

        // 5. 文件大小
        if (selectedFile) {
            const mb = (selectedFile.size / (1024 * 1024)).toFixed(2);
            document.getElementById('info_size').textContent = `${mb} MB`;
        }

        // 6. 文件格式
        if (selectedFile) {
            const ext = selectedFile.name.substring(selectedFile.name.lastIndexOf('.')).toLowerCase();
            const formatMap = {
                '.mcworld': '.mcworld (基岩版导出包)',
                '.zip': '.zip (压缩归档)',
                '.dat': 'level.dat (原NBT数据文件)'
            };
            document.getElementById('info_format').textContent = formatMap[ext] || `${ext} 文件`;
        }

        // 7. NBT 状态
        document.getElementById('info_nbt_status').textContent = '解析成功';
        document.getElementById('info_nbt_status').className = 'badge badge-good';

        document.getElementById('statusCard').style.display = 'block';
        document.getElementById('actionGroup').style.display = 'flex';
        const needsFix = targetKeys.some(k => parsedNBT[k] === 1) || parsedNBT.GameType !== 0;
        
        updateBadge('val_creative', parsedNBT.hasBeenLoadedInCreative);
        updateBadge('val_cheats', parsedNBT.cheatsEnabled);
        updateBadge('val_commands', parsedNBT.commandsEnabled);

        const box = document.getElementById('summaryBox'), text = document.getElementById('summaryText');
        if (needsFix) {
            box.style.cssText = 'background:rgba(212, 166, 54, 0.1);border:2px solid rgba(212, 166, 54, 0.3)';
            text.style.color = '#f0c146';
            text.textContent = '⚠️ 检测到限制标记或非生存模式！点击修复将自动重置并恢复生存模式。';
            document.getElementById('fixBtn').disabled = false;
        } else {
            box.style.cssText = 'background:rgba(84, 167, 44, 0.1);border:2px solid rgba(84, 167, 44, 0.3)';
            text.style.color = '#89e05a';
            text.textContent = '✅ 存档状态正常，成就资格完好！';
            document.getElementById('fixBtn').disabled = true;
        }
    }

    function updateBadge(id, val) {
        const el = document.getElementById(id);
        if (val === 1) { el.textContent = '1 (异常)'; el.className = 'badge badge-bad'; }
        else if (val === 0) { el.textContent = '0 (正常)'; el.className = 'badge badge-good'; }
        else { el.textContent = '未找到'; el.className = 'badge'; }
    }

    // ===== 修复并导出 =====
    document.getElementById('fixBtn').addEventListener('click', async () => {
        if (window.isDemoMode) {
            log('>> [演示模式] 模拟修复逻辑运行中...');
            log('   ✓ hasBeenLoadedInCreative → 0');
            log('   ✓ GameType → 0 (生存模式)');
            log('   ✓ 校验通过');
            
            parsedNBT_demo.hasBeenLoadedInCreative = 0;
            parsedNBT_demo.cheatsEnabled = 0;
            parsedNBT_demo.commandsEnabled = 0;
            parsedNBT_demo.GameType = 0;
            parsedNBT = parsedNBT_demo;
            analyzeAndRender();

            log('🎉 [演示完成] 真实模式下此时将自动下载修复好的 .mcworld 文件！');
            return;
        }

        log('>> 开始精准修复...');
        const view = new DataView(rawLevelDat.buffer, rawLevelDat.byteOffset, rawLevelDat.byteLength);
        
        let offset = 0;
        if (rawLevelDat.length > 8 && view.getUint8(8) === TAG_COMPOUND) offset = 8;
        offset++;
        
        const rootNameLen = view.getUint16(offset, true); offset += 2 + rootNameLen;

        while (offset < rawLevelDat.length) {
            const tagType = view.getUint8(offset++);
            if (tagType === TAG_END) break;
            
            const nameLen = view.getUint16(offset, true); offset += 2;
            const name = new TextDecoder().decode(rawLevelDat.subarray(offset, offset + nameLen));
            offset += nameLen;

            if (tagType === TAG_BYTE && targetKeys.includes(name)) {
                if (view.getInt8(offset) !== 0) {
                    view.setInt8(offset, 0);
                    log(`   ✓ ${name} → 0`);
                }
                offset++;
            } else if (tagType === TAG_INT && name === 'GameType') {
                if (view.getInt32(offset, true) !== 0) {
                    view.setInt32(offset, 0, true);
                    log('   ✓ GameType → 0 (强制还原生存模式)');
                }
                offset += 4;
            } else {
                offset += skipTag(tagType, view, offset);
            }
        }

        log('>> 校验写入结果...');
        let verifyOff = 0;
        if (rawLevelDat.length > 8 && view.getUint8(8) === TAG_COMPOUND) verifyOff = 8;
        verifyOff++;
        const vRootLen = view.getUint16(verifyOff, true); verifyOff += 2 + vRootLen;

        let allOk = true;
        while (verifyOff < rawLevelDat.length) {
            const t = view.getUint8(verifyOff++); if (t === TAG_END) break;
            const nl = view.getUint16(verifyOff, true); verifyOff += 2;
            const n = new TextDecoder().decode(rawLevelDat.subarray(verifyOff, verifyOff + nl));
            verifyOff += nl;
            if (t === TAG_BYTE && targetKeys.includes(n) && view.getInt8(verifyOff) !== 0) {
                allOk = false; log(`   ✗ 校验失败：${n} 未归零！`);
            }
            if (t === TAG_BYTE && targetKeys.includes(n)) {
                verifyOff++;
            } else if (t === TAG_INT && n === 'GameType') {
                verifyOff += 4;
            } else {
                verifyOff += skipTag(t, view, verifyOff);
            }
        }
        if (!allOk) return alert('校验失败！请重试或联系开发者。');
        log('   ✓ 校验通过');

        if (isSingleDat) {
            log('>> 生成修复后的 level.dat ...');
            const blob = new Blob([rawLevelDat], { type: 'application/octet-stream' });
            downloadFile(blob, 'level.dat');
            log('🎉 完成！已下载修复后的 level.dat。');
            
            targetKeys.forEach(k => parsedNBT[k] = 0);
            parsedNBT.GameType = 0;
            analyzeAndRender();
            return;
        }

        log('>> 生成压缩包（含备份 level.dat.bak）...');
        const newZip = new JSZip();
        for (let path in zipInstance.files) {
            const f = zipInstance.files[path];
            if (f.dir) continue;

            if (path.toLowerCase().endsWith('level.dat_old')) { 
                log('   跳过旧备份 level.dat_old'); 
                continue; 
            }

            if (path === targetLevelDatPath) {
                newZip.file(path + '.bak', originalBackup);
                newZip.file(path, rawLevelDat);
            } else {
                newZip.file(path, await f.async('uint8array'));
            }
        }

        const blob = await newZip.generateAsync({ 
            type: 'blob', 
            mimeType: 'application/x-minecraft-world',
            compression: 'STORE' 
        });
        
        const outName = '成就修复_' + selectedFile.name.replace(/\.(zip|mcworld)$/i, '') + '.mcworld';
        downloadFile(blob, outName);
        log('🎉 完成！已下载，包内含 level.dat.bak 原始备份。');

        targetKeys.forEach(k => parsedNBT[k] = 0);
        parsedNBT.GameType = 0;
        analyzeAndRender();
    });

    function downloadFile(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.rel = 'noopener';
        document.body.appendChild(a); 
        a.click(); 
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 2000);
    }

    document.getElementById('resetBtn').addEventListener('click', () => {
        zipInstance = null;
        targetLevelDatPath = null;
        rawLevelDat = null;
        selectedFile = null;
        parsedNBT = {};
        originalBackup = null;
        isSingleDat = false;
        window.isDemoMode = false;

        fileInput.value = '';
        document.getElementById('fileTitle').textContent = '点击 或 拖拽文件到此处';
        document.getElementById('fileSub').textContent = '支持 .mcworld / .zip / level.dat · 基岩版专用';

        document.getElementById('introGuides').style.display = 'block';
        document.getElementById('loadDemoBtn').style.display = 'inline-block';

        document.getElementById('infoCard').style.display = 'none';
        document.getElementById('statusCard').style.display = 'none';
        document.getElementById('actionGroup').style.display = 'none';

        const logDiv = document.getElementById('log');
        logDiv.textContent = '';
        logDiv.style.display = 'none';
    });
})();
